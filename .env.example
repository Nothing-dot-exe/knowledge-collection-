# ── Knowledge Agent Environment Configuration ──────────────────────
# Copy this file to .env and fill in your private credentials.
# Do NOT commit your real .env file to GitHub.

# GitHub Vault Storage (Personal Access Token with 'repo' scope)
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPO_URL=https://github.com/YourUsername/your-repo-name

# Telegram Bot & Topic Routing
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_GROUP_ID=-1001234567890
RAW_PDF_TOPIC_ID=10
TEXT_MD_TOPIC_ID=11
ADMIN_CHAT_ID=123456789

# Pipeline Settings
PAPERS_PER_CATEGORY=15
